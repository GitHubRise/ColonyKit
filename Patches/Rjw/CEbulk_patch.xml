			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="Condom"]/statBases</xpath>
					<value>
						<Bulk>0.01</Bulk>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="HumpShroom"]/statBases</xpath>
