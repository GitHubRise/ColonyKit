				<li Class="ThinkNode_PrioritySorter">
					<subNodes>
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotCharge" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotRescue" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotFirefight" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotDoctor" />
