<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThinkTreeDef>
		<defName>CK_NannyBot</defName>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>
				<li Class="ThinkNode_Subtree">
					<treeDef>Downed</treeDef>
				</li>
				<li Class="ThinkNode_Subtree">
					<treeDef>BurningResponse</treeDef>
				</li>
				<li Class="ThinkNode_QueuedJob" />
				<!-- 加入远行队后，商队职责压过所有自动行为：先搬物资、去集合点、随队出发。
				     必须排在所有 JobGiver 前面，否则机器人会被家务/巡逻/索敌拖住，远行队迟迟走不了。 -->
				<li Class="ColonyKit.Modules.Robotics.ThinkNode_ConditionalFormingCaravan">
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>LordDuty</treeDef>
						</li>
					</subNodes>
				</li>
				<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotFlee" />
				<li Class="ThinkNode_PrioritySorter">
					<subNodes>
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotCharge" />
						<!-- 伤得比较重时去空医疗床躺着慢慢恢复；床不够/没有床就跳过，照常干活或野外自修复。 -->
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotBedRest" />
						<!-- 仿生人设定：机械保姆也要喝水、上厕所；卫生模块关闭时这些 JobGiver 会自行返回 0 优先级。 -->
						<li Class="ColonyKit.Modules.Hygiene.JobGiver_DrinkWaterUrgent" />
						<li Class="ColonyKit.Modules.Hygiene.JobGiver_UseToilet" />
						<li Class="ColonyKit.Modules.Hygiene.JobGiver_DrinkWater" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotRescue" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotFirefight" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotDoctor" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotCook" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotResearch" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotCrafting" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotRefuel" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotHygiene" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotWater" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotFeedPrisoner" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotPlants" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotRopeAnimals" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotSweep" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotScrub" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotHaul" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotButcher" />
						<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotCorpseDisposal" />
					</subNodes>
				</li>
				<li Class="ColonyKit.Modules.Robotics.JobGiver_NannyBotIdle" />
			</subNodes>
		</thinkRoot>
	</ThinkTreeDef>

	<ThinkTreeDef>
		<defName>CK_MkVAndroid</defName>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>
				<li Class="ThinkNode_Subtree">
					<treeDef>Downed</treeDef>
				</li>
				<li Class="ThinkNode_Subtree">
					<treeDef>BurningResponse</treeDef>
				</li>
				<li Class="ThinkNode_QueuedJob" />
				<!-- 远行队最高优先：Mk-V 自己的索敌/捡枪/守卫都要给商队职责让路。 -->
				<li Class="ColonyKit.Modules.Robotics.ThinkNode_ConditionalFormingCaravan">
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>LordDuty</treeDef>
						</li>
					</subNodes>
				</li>
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVCombat" />
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVWeaponPickup" />
				<!-- 地图上没有殖民者时，Mk-V 是唯一的守卫：先站岗，再谈家务。 -->
				<li Class="ColonyKit.Modules.Robotics.ThinkNode_ConditionalNoColonists">
					<subNodes>
						<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVGuard" />
					</subNodes>
				</li>
				<!-- 原版 JobGiver_PickUpOpportunisticWeapon 不检查 IsForbidden；丢下的武器默认被禁用，会每 tick 重复下 Equip 并触发 started 10 jobs 报错。自动换枪交给上面的专用评分逻辑。 -->
				<li Class="ThinkNode_Subtree">
					<treeDef>CK_NannyBot</treeDef>
				</li>
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVGuard" />
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVCloudwatch" />
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVWander" />
			</subNodes>
		</thinkRoot>
	</ThinkTreeDef>
</Defs>
