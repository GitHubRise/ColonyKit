	<ThinkTreeDef>
		<defName>CK_MkVAndroid</defName>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>
				<li Class="ThinkNode_Subtree">
					<treeDef>Downed</treeDef>
				</li>
				<li Class="ThinkNode_Subtree">
					<treeDef>BurningResponse</treeDef>
				</li>
				<li Class="ThinkNode_QueuedJob" />
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVCombat" />
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVWeaponPickup" />
				<!-- 原版 JobGiver_PickUpOpportunisticWeapon 不检查 IsForbidden；丢下的武器默认被禁用，会每 tick 重复下 Equip 并触发 started 10 jobs 报错。自动换枪交给上面的专用评分逻辑。 -->
				<li Class="ThinkNode_Subtree">
					<treeDef>CK_NannyBot</treeDef>
				</li>
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVGuard" />
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVCloudwatch" />
				<li Class="ColonyKit.Modules.Robotics.JobGiver_MkVWander" />
			</subNodes>
		</thinkRoot>
	</ThinkTreeDef>
