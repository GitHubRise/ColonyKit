<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BasePawn">
		<defName>CK_RobotNanny</defName>
		<label>nanny robot</label>
		<description>A gentle domestic mechanoid that sweeps, scrubs and hauls for the colony. It runs on a built-in battery and returns to its charging station when power is low. It cannot fight, eat, sleep or socialize.</description>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<statBases>
			<MoveSpeed>4</MoveSpeed>
			<MarketValue>1200</MarketValue>
			<Mass>40</Mass>
			<ComfyTemperatureMin>-50</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<Flammability>0</Flammability>
			<ArmorRating_Sharp>0.2</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.1</ArmorRating_Blunt>
			<ArmorRating_Heat>1</ArmorRating_Heat>
			<CarryingCapacity>75</CarryingCapacity>
			<CleaningSpeed>1.25</CleaningSpeed>
			<PsychicSensitivity>0</PsychicSensitivity>
			<ToxicResistance>1</ToxicResistance>
		</statBases>
		<race>
			<body>CK_NannyBotBody</body>
			<baseBodySize>0.8</baseBodySize>
			<baseHealthScale>0.9</baseHealthScale>
			<intelligence>ToolUser</intelligence>
			<thinkTreeMain>CK_NannyBot</thinkTreeMain>
			<fleshType>Mechanoid</fleshType>
			<needsRest>false</needsRest>
			<foodType>None</foodType>
			<hasGenders>false</hasGenders>
			<lifeExpectancy>2500</lifeExpectancy>
			<bloodDef>Filth_MachineBits</bloodDef>
			<renderTree>Misc</renderTree>
			<canBecomeShambler>false</canBecomeShambler>
			<lifeStageAges>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
				</li>
			</lifeStageAges>
		</race>
		<butcherProducts>
			<Steel>20</Steel>
		</butcherProducts>
		<inspectorTabs>
			<li>ITab_Pawn_Health</li>
			<li>ITab_Pawn_Needs</li>
			<li>ITab_Pawn_Log</li>
		</inspectorTabs>
		<comps>
			<li Class="ColonyKit.Modules.Robotics.CompProperties_NannyBot" />
		</comps>
	</ThingDef>

	<PawnKindDef>
		<defName>CK_RobotMkVKind</defName>
		<label>Mk-V nanny robot</label>
		<race>CK_RobotNanny</race>
		<defaultFactionDef>PlayerColony</defaultFactionDef>
		<combatPower>0</combatPower>
		<isFighter>false</isFighter>
		<canStrip>false</canStrip>
		<destroyGearOnDrop>false</destroyGearOnDrop>
		<lifeStages>
			<li>
				<bodyGraphicData>
					<texPath>Things/Pawn/MkV/MkV</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>1.15</drawSize>
					<shadowData>
						<volume>(0.45, 0.5, 0.45)</volume>
					</shadowData>
				</bodyGraphicData>
			</li>
		</lifeStages>
	</PawnKindDef>

	<PawnKindDef>
		<defName>CK_RobotNannyKind</defName>
		<label>nanny robot</label>
		<race>CK_RobotNanny</race>
		<defaultFactionDef>PlayerColony</defaultFactionDef>
		<combatPower>0</combatPower>
		<isFighter>false</isFighter>
		<canStrip>false</canStrip>
		<destroyGearOnDrop>false</destroyGearOnDrop>
		<lifeStages>
			<li>
				<bodyGraphicData>
					<texPath>Things/Pawn/NannyBot/NannyBot</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>1.15</drawSize>
					<shadowData>
						<volume>(0.45, 0.5, 0.45)</volume>
					</shadowData>
				</bodyGraphicData>
			</li>
		</lifeStages>
	</PawnKindDef>
</Defs>
