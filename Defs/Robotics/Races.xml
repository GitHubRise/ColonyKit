<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BasePawn">
		<defName>CK_RobotNanny</defName>
		<label>nanny robot</label>
		<description>A gentle domestic mechanoid that sweeps, scrubs and hauls for the colony. It runs on a built-in battery and returns to its charging station when power is low. It cannot fight, eat, sleep or socialize.</description>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<statBases>
			<MoveSpeed>4</MoveSpeed>
			<MarketValue>1200</MarketValue>
			<Mass>40</Mass>
			<ComfyTemperatureMin>-50</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<Flammability>0</Flammability>
			<ArmorRating_Sharp>0.2</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.1</ArmorRating_Blunt>
			<ArmorRating_Heat>1</ArmorRating_Heat>
			<CarryingCapacity>75</CarryingCapacity>
			<CleaningSpeed>1.25</CleaningSpeed>
			<PsychicSensitivity>0</PsychicSensitivity>
			<ToxicResistance>1</ToxicResistance>
		</statBases>
		<race>
			<body>CK_NannyBotBody</body>
			<baseBodySize>0.8</baseBodySize>
			<baseHealthScale>0.9</baseHealthScale>
			<intelligence>ToolUser</intelligence>
			<thinkTreeMain>CK_NannyBot</thinkTreeMain>
			<fleshType>Mechanoid</fleshType>
			<needsRest>false</needsRest>
			<foodType>None</foodType>
			<hasGenders>false</hasGenders>
			<lifeExpectancy>2500</lifeExpectancy>
			<bloodDef>Filth_MachineBits</bloodDef>
			<renderTree>Misc</renderTree>
			<canBecomeShambler>false</canBecomeShambler>
			<lifeStageAges>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
				</li>
			</lifeStageAges>
		</race>
		<butcherProducts>
			<Steel>20</Steel>
		</butcherProducts>
		<inspectorTabs Inherit="False">
			<li>ColonyKit.Modules.Robotics.ITab_Pawn_RobotInfo</li>
			<li>ITab_Pawn_Gear</li>
			<li>ITab_Pawn_Health</li>
			<li>ITab_Pawn_Needs</li>
			<li>ITab_Pawn_Log</li>
		</inspectorTabs>
		<comps>
			<li Class="ColonyKit.Modules.Robotics.CompProperties_NannyBot" />
		</comps>
	</ThingDef>

	<ThingDef ParentName="BasePawn">
		<defName>CK_RobotMkV</defName>
		<label>Mk-V nanny robot</label>
		<description>A combat-capable Mk-V household android. It shares the nanny robot chassis and battery system, but uses a dedicated combat ThinkTree and can equip external weapons.</description>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<statBases>
			<MoveSpeed>4.2</MoveSpeed>
			<MarketValue>2500</MarketValue>
			<Mass>45</Mass>
			<ComfyTemperatureMin>-50</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<Flammability>0</Flammability>
			<ArmorRating_Sharp>0.9</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.6</ArmorRating_Blunt>
			<ArmorRating_Heat>3</ArmorRating_Heat>
			<CarryingCapacity>75</CarryingCapacity>
			<CleaningSpeed>1.25</CleaningSpeed>
			<PsychicSensitivity>0</PsychicSensitivity>
			<ToxicResistance>1</ToxicResistance>
		</statBases>
		<race>
			<body>CK_MkVBody</body>
			<baseBodySize>1.1</baseBodySize>
			<baseHealthScale>1.1</baseHealthScale>
			<intelligence>ToolUser</intelligence>
			<thinkTreeMain>CK_MkVAndroid</thinkTreeMain>
			<fleshType>Mechanoid</fleshType>
			<needsRest>false</needsRest>
			<foodType>None</foodType>
			<hasGenders>true</hasGenders>
			<lifeExpectancy>2500</lifeExpectancy>
			<bloodDef>Filth_MachineBits</bloodDef>
			<renderTree>CK_MkV</renderTree>
			<canBecomeShambler>false</canBecomeShambler>
			<lifeStageAges>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
				</li>
			</lifeStageAges>
		</race>
				<tools>
			<li>
				<label>arc blade</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<!-- 1.8x the original 22 power: 22 * 1.8 = 39.6 -->
				<power>39.6</power>
				<cooldownTime>1.5</cooldownTime>
				<armorPenetration>0.25</armorPenetration>
			</li>
		</tools>
<butcherProducts>
			<Steel>20</Steel>
		</butcherProducts>
		<inspectorTabs Inherit="False">
			<li>RimWorld.ITab_Pawn_Character</li>
			<li>ITab_Pawn_Gear</li>
			<li>ITab_Pawn_Health</li>
			<li>ITab_Pawn_Needs</li>
			<li>ITab_Pawn_Log</li>
		</inspectorTabs>
		<comps>
			<li Class="ColonyKit.Modules.Robotics.CompProperties_NannyBot" />
			<li Class="ColonyKit.Modules.Robotics.CompProperties_MkVCombat" />
		</comps>
	</ThingDef>

