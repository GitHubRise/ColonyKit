<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Mk-V 的内置隔寒/隔热：只在这个 PawnKind 的属性页显示，数值由设置页实时提供。 -->
	<StatDef>
		<defName>CK_MkVInsulationCold</defName>
		<label>Mk-V cold insulation</label>
		<description>Built-in cold insulation of the Mk-V chassis. It lowers the comfortable temperature floor by this many degrees.</description>
		<category>PawnMisc</category>
		<defaultBaseValue>0</defaultBaseValue>
		<minValue>0</minValue>
		<toStringStyle>Temperature</toStringStyle>
		<displayPriorityInCategory>4050</displayPriorityInCategory>
		<showOnDefaultValue>true</showOnDefaultValue>
		<showOnHumanlikes>false</showOnHumanlikes>
		<showOnAnimals>false</showOnAnimals>
		<showOnPawnKind>
			<li>CK_RobotMkVKind</li>
		</showOnPawnKind>
	</StatDef>

	<StatDef>
		<defName>CK_MkVInsulationHeat</defName>
		<label>Mk-V heat insulation</label>
		<description>Built-in heat insulation of the Mk-V chassis. It raises the comfortable temperature ceiling by this many degrees.</description>
		<category>PawnMisc</category>
		<defaultBaseValue>0</defaultBaseValue>
		<minValue>0</minValue>
		<toStringStyle>Temperature</toStringStyle>
		<displayPriorityInCategory>4049</displayPriorityInCategory>
		<showOnDefaultValue>true</showOnDefaultValue>
		<showOnHumanlikes>false</showOnHumanlikes>
		<showOnAnimals>false</showOnAnimals>
		<showOnPawnKind>
			<li>CK_RobotMkVKind</li>
		</showOnPawnKind>
	</StatDef>
</Defs>
