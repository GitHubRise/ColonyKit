<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BaseGun">
		<defName>CK_ArcEmitter</defName>
		<label>arc emitter</label>
		<description>A compact arc emitter designed as the Mk-V android's standard weapon. It fires short-lived electric bolts in a five-round burst that burns and staggers the target. In Mk-V hands its range is extended by a further 15 cells.</description>
		<techLevel>Spacer</techLevel>
		<modExtensions>
			<li Class="ColonyKit.Modules.Robotics.DefModExtension_MkvExclusiveWeapon">
				<rangeBonus>15</rangeBonus>
			</li>
		</modExtensions>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/CK_ArcEmitter</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.15</uiIconScale>
		<statBases>
			<Mass>4.5</Mass>
			<MarketValue>1200</MarketValue>
			<MaxHitPoints>150</MaxHitPoints>
			<AccuracyTouch>0.79</AccuracyTouch>
			<AccuracyShort>0.72</AccuracyShort>
			<AccuracyMedium>0.72</AccuracyMedium>
			<AccuracyLong>0.66</AccuracyLong>
			<RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>Gun</li>
			<li>SpacerGun</li>
		</weaponTags>
		<tradeTags>
			<li>WeaponRanged</li>
		</tradeTags>
		<weaponClasses>
			<li>RangedHeavy</li>
		</weaponClasses>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CK_ArcBolt</defaultProjectile>
				<warmupTime>0.8</warmupTime>
				<burstShotCount>5</burstShotCount>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<range>36</range>
				<soundCast>Shot_ChargeRifle</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>8</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>6</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
	</ThingDef>

	<!-- Mk-V 的专用近战武器：和机体内置的电弧刃同名，组装出来就挂在副手上，
	     和电弧发射器组成「远程 + 近战」双持。直接挂 BaseWeapon、不做品质/材质也没有
	     制作账单（继承 BaseMeleeWeapon_Sharp 会带一个空 recipeMaker 报 Config error），
	     数值固定；专属扩展只挂在电弧发射器上，所以换装时它仍然是可以被替换的普通武器。 -->
	<ThingDef ParentName="BaseWeapon">
		<defName>CK_ArcBlade</defName>
		<label>arc blade</label>
		<description>An arc blade built for the Mk-V chassis: a heavy alloy spine with a plasma-lit edge and an articulated grip that plugs into the android's forearm socket. The Mk-V carries it in its free hand while the arc emitter stays in the other.</description>
		<techLevel>Spacer</techLevel>
		<possessionCount>1</possessionCount>
		<smeltable>true</smeltable>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponMelee/CK_ArcBlade</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.15</uiIconScale>
		<thingCategories>
			<li>WeaponsMelee</li>
		</thingCategories>
		<weaponClasses>
			<li>Melee</li>
			<li>MeleePiercer</li>
		</weaponClasses>
		<statBases>
			<Mass>3.2</Mass>
			<MarketValue>1350</MarketValue>
			<MaxHitPoints>260</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<smeltProducts>
			<Steel>10</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</smeltProducts>
		<weaponTags>
			<li>SpacerMelee</li>
		</weaponTags>
		<tradeTags>
			<li>WeaponMelee</li>
		</tradeTags>
		<tools>
			<li>
				<label>plasma edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>44</power>
				<cooldownTime>1.4</cooldownTime>
				<armorPenetration>0.35</armorPenetration>
			</li>
			<li>
				<label>point</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>26</power>
				<cooldownTime>1.4</cooldownTime>
				<armorPenetration>0.2</armorPenetration>
			</li>
		</tools>
	</ThingDef>

	<ThingDef ParentName="BaseBullet">
		<defName>CK_ArcBolt</defName>
		<label>arc bolt</label>
		<thingClass>ColonyKit.Modules.Robotics.Projectile_CKArcBolt</thingClass>
		<graphicData>
			<texPath>Things/Projectile/CK_ArcBolt</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Burn</damageDef>
			<damageAmountBase>58</damageAmountBase>
			<armorPenetrationBase>0.35</armorPenetrationBase>
			<stoppingPower>1.5</stoppingPower>
			<speed>70</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="MoteBase">
		<defName>CK_Mote_ArcImpact</defName>
		<graphicData>
			<texPath>Things/Mote/CK_ArcImpact</texPath>
		</graphicData>
		<altitudeLayer>Projectile</altitudeLayer>
		<mote>
			<fadeInTime>0.03</fadeInTime>
			<solidTime>0.10</solidTime>
			<fadeOutTime>0.24</fadeOutTime>
			<collide>false</collide>
		</mote>
	</ThingDef>
</Defs>
