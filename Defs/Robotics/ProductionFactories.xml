<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_WorkshopFactory</defName>
		<label>workshop robot factory</label>
		<description>A compact workshop that assembles Mk-I nanny robots from a single bill. The first production building in the robotics line.</description>
		<thingClass>Building</thingClass>
		<tickerType>Normal</tickerType>
		<size>(2,2)</size>
		<graphicData>
			<texPath>Things/Building/Robotics/WorkshopFactory/WorkshopFactory</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<rotatable>false</rotatable>
		<designationCategory>CK_Robotics</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>0</pathCost>
		<fillPercent>0.45</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<uiIconScale>0.85</uiIconScale>
		<costList>
			<Steel>220</Steel>
			<ComponentIndustrial>8</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<statBases>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>60</Mass>
			<WorkToBuild>6000</WorkToBuild>
			<Beauty>0</Beauty>
			<Flammability>0</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>CK_NannyBot</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>220</basePowerConsumption>
			</li>
			<li Class="ColonyKit.Modules.Robotics.CompProperties_RobotFactory">
				<factoryTier>1</factoryTier>
				<productKind>CK_NannyBotMkIKind</productKind>
				<idlePower>350</idlePower>
				<workPower>900</workPower>
			</li>
		</comps>
	</ThingDef>

