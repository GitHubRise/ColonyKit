<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- RJW only ships a mechanical penis. Mk-V is female, so add a matching artificial vagina
	     at the MechGenitals body part; MechanoidsCompatibility recognizes any artificial part there. -->
	<rjw.HediffDef_SexPart ParentName="ArtificialPrivatePartMech">
		<defName>CK_ArtificialVaginaMech</defName>
		<label>mechanical vagina</label>
		<labelNoun>a mechanical vagina</labelNoun>
		<description>An artificial vaginal unit built into the Mk-V chassis.</description>
		<defaultBodyPart>MechGenitals</defaultBodyPart>
		<sizeProfile>DefaultVaginaSizes</sizeProfile>
		<genitalFamily>Vagina</genitalFamily>
		<genitalTags>
			<li>CanBePenetrated</li>
			<li>CanBeFertilized</li>
		</genitalTags>
		<stages>
			<li>
				<label>Micro</label>
				<minSeverity>0.01</minSeverity>
			</li>
			<li>
				<label>Tight</label>
				<minSeverity>0.20</minSeverity>
			</li>
			<li>
				<label>Average</label>
				<minSeverity>0.40</minSeverity>
			</li>
			<li>
				<label>Loose</label>
				<minSeverity>0.60</minSeverity>
			</li>
			<li>
				<label>Gaping</label>
				<minSeverity>0.80</minSeverity>
			</li>
		</stages>
	</rjw.HediffDef_SexPart>

	<rjw.HediffDef_SexPart ParentName="ArtificialPrivatePartMech">
		<defName>CK_ArtificialBreastsMech</defName>
		<label>mechanical breasts</label>
		<labelNoun>mechanical breasts</labelNoun>
		<description>Artificial breast units built into the Mk-V chassis.</description>
		<defaultBodyPart>MechChest</defaultBodyPart>
		<sizeProfile>DefaultBreastSizes</sizeProfile>
		<genitalFamily>Breasts</genitalFamily>
		<genitalTags>
			<li>CanLactate</li>
		</genitalTags>
		<stages>
			<li>
				<label>Nipples</label>
				<minSeverity>0.01</minSeverity>
			</li>
			<li>
				<label>Tiny</label>
				<minSeverity>0.02</minSeverity>
			</li>
			<li>
				<label>Small</label>
				<minSeverity>0.20</minSeverity>
			</li>
			<li>
				<label>Average</label>
				<minSeverity>0.40</minSeverity>
			</li>
			<li>
				<label>Large</label>
				<minSeverity>0.60</minSeverity>
			</li>
			<li>
				<label>Huge</label>
				<minSeverity>0.80</minSeverity>
			</li>
			<li>
				<label>Enormous</label>
				<minSeverity>1.00</minSeverity>
			</li>
		</stages>
	</rjw.HediffDef_SexPart>
</Defs>
