<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<HediffDef Name="Sex_Change_Thoughts_Syndrome" Abstract="True">
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(1, 0.41, 0.71)</defaultLabelColor>
		<!--这会从最高严重度开始逐渐下降，代码会根据具体小人需要调整初始严重度-->
		<description>A psychological adjustment following sex reassignment surgery. The mind struggles to reconcile sudden physical changes with its sense of self.</description>
		<initialSeverity>1.0</initialSeverity>
		<minSeverity>0.001</minSeverity>
		<maxSeverity>1.0</maxSeverity>
		<isBad>false</isBad>
		<tendable>false</tendable>
		<scenarioCanAdd>false</scenarioCanAdd>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.01</severityPerDay>
			</li>
			<li Class="HediffCompProperties_Disappears">
				<!--这些阶段很长，但最低阶段其实是心情加成。-->
				<!--代码会调整严重度，使有些小人立刻感到满足，另一些则只是逐渐适应直到效果消失-->
				<disappearsAfterTicks>
					<!--60 天（1 年）-->
					<min>3600000</min>
					<!--1.5 年-->
					<max>4800000</max>
				</disappearsAfterTicks>
			</li>
		</comps>

		<stages>
			<li>
				<label>ignorance</label>
				<becomeVisible>false</becomeVisible>
			</li>
			<li>
				<label>acceptance</label>
				<minSeverity>0.01</minSeverity>
				<becomeVisible>false</becomeVisible>
			</li>
			<li>
				<label>sadness</label>
				<minSeverity>0.25</minSeverity>
				<becomeVisible>false</becomeVisible>
			</li>
			<li>
				<label>anger</label>
				<becomeVisible>false</becomeVisible>
				<minSeverity>0.4</minSeverity>
			</li>
			<li>
				<label>rejection</label>
				<minSeverity>0.7</minSeverity>
				<becomeVisible>false</becomeVisible>
			</li>
		</stages>
	</HediffDef>

