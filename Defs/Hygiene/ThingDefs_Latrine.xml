<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 旱厕：DBH PitLatrine 的对应物（数值与逻辑照搬）。
	     不要求 CK_HygieneResearch，给部落和开局当最便宜的如厕方案；
	     刻意不挂水管/污水管：和马桶、浴缸不同，旱厕完全靠小人手动清空。
	     贴图直接用 DBH 的 Latrine_*（64×64，drawSize 1×1）。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_PitLatrine</defName>
		<label>pit latrine</label>
		<description>A pit latrine. Needs no water, power or plumbing: waste drops into a 500-unit pit (14 per use) that must be emptied by a colonist. Unlike toilets and bathtubs it never connects to a pipe network.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Latrine</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_PitLatrine</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1,1)</drawSize>
			<shaderType>Cutout</shaderType>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>5</uiOrder>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<costList>
			<WoodLog>25</WoodLog>
		</costList>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<Mass>8</Mass>
			<WorkToBuild>550</WorkToBuild>
			<Beauty>-6</Beauty>
			<Cleanliness>-5</Cleanliness>
			<Flammability>1</Flammability>
		</statBases>
	</ThingDef>
</Defs>
