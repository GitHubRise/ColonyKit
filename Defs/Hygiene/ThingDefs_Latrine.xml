<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 旱厕：DBH PitLatrine 的对应物。刻意不挂 CompProperties_Pipe / CompProperties_Power，
	     也不要求 CK_HygieneResearch，给部落和开局当最便宜的如厕方案。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_PitLatrine</defName>
		<label>pit latrine</label>
		<description>A pit latrine. No water or power needed: waste drops into a 500-unit pit (14 per use). Once the pit is full it must be emptied by a colonist before it can be used again.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Latrine</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_PitLatrine</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<shaderType>Cutout</shaderType>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>5</uiOrder>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<costList>
			<WoodLog>25</WoodLog>
		</costList>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<Mass>8</Mass>
			<WorkToBuild>550</WorkToBuild>
			<Beauty>-6</Beauty>
			<Cleanliness>-5</Cleanliness>
			<Flammability>1</Flammability>
		</statBases>
	</ThingDef>
</Defs>
