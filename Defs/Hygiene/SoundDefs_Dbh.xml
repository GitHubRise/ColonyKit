<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- DBH 卫生音效（12 个）：HygieneSounds.xml 的 1:1 移植，defName 加 CK_ 前缀，音效仍指向 Sounds/DBH 下的 ogg。
	     CK_StallDoor（ThingDefs_StallDoor.xml）与 CK_WashingMachine（ThingDefs_WashingMachine.xml）已定义，这里不再重复。 -->
	<SoundDef>
		<defName>CK_VacuumToilet</defName>
		<context>MapOnly</context>
		<eventNames />
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>DBH/vacuumtoilet</clipPath>
					</li>
				</grains>
				<volumeRange>
					<min>7</min>
					<max>7</max>
				</volumeRange>
				<distRange>
					<min>0</min>
					<max>50.27907</max>
				</distRange>
				<sustainLoop>False</sustainLoop>
			</li>
		</subSounds>
	</SoundDef>

