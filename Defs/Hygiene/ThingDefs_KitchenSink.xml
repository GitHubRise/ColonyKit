<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 厨房水槽（DBH KitchenSink 的 1:1 移植）：3×1 的大洗手池，Cleanliness 5。
	     复用 Building_Basin 的洗手逻辑，只是尺寸、贴图和清洁度不同。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_KitchenSink</defName>
		<label>kitchen sink</label>
		<description>Everything but a kitchen sink. Increases room cleanliness.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Basin</thingClass>
		<tickerType>Normal</tickerType>
		<size>(3,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_KitchenSink</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,2)</drawSize>
			<shaderType>CutoutComplex</shaderType>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>14</uiOrder>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<costList>
			<Steel>15</Steel>
		</costList>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>35</costStuffCount>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<WorkToBuild>550</WorkToBuild>
			<Flammability>1</Flammability>
			<Cleanliness>5</Cleanliness>
			<Beauty>10</Beauty>
			<Mass>5</Mass>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_ModernFixtures</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
