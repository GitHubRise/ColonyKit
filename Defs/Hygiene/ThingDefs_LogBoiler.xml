<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 柴火锅炉（DBH LogBoiler 的 1:1 移植）：烧原木，2000 加热单位，同时给房间加热。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_LogBoiler</defName>
		<label>log boiler</label>
		<description>Produces 2000 heating units for piped radiators and hot water tanks. Heats the room and adjacent baths. Requires wood logs for fuel.</description>
		<thingClass>Building</thingClass>
		<tickerType>Normal</tickerType>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_LogBoiler</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<damageData>
				<rect>(0.05,0.05,0.95,0.95)</rect>
			</damageData>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>30</uiOrder>
		<blockWind>true</blockWind>
		<castEdgeShadows>false</castEdgeShadows>
		<pathCost>150</pathCost>
		<costList>
			<Steel>200</Steel>
		</costList>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>1000</WorkToBuild>
			<Mass>50</Mass>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_WaterHeater">
				<Capacity>2000</Capacity>
				<ThermostatControl>false</ThermostatControl>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Refuelable">
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<fuelConsumptionRate>10</fuelConsumptionRate>
				<fuelCapacity>75</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>WoodLog</li>
					</thingDefs>
				</fuelFilter>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>6</glowRadius>
				<glowColor>(217,112,33,0)</glowColor>
			</li>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>21</heatPerSecond>
				<heatPushMaxTemperature>28</heatPushMaxTemperature>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_LogBoilers</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
