<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_Shower</defName>
		<label>simple shower</label>
		<description>A 1x1 shower that can be placed anywhere. Needs water. Powered showers are hot; without power, a working water heater on the same network can still provide hot water. Otherwise it is a cold shower.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Shower</thingClass>
		<size>(1,1)</size>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_Shower</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>Standable</passability>
		<pathCost>0</pathCost>
		<fillPercent>0.15</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<uiIconScale>0.8</uiIconScale>
		<costList>
			<Steel>15</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<Mass>10</Mass>
			<WorkToBuild>800</WorkToBuild>
			<Beauty>2</Beauty>
			<Flammability>0</Flammability>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>75</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_ShowerPower</defName>
		<label>power shower</label>
		<description>DBH power shower: heats water on demand, cleans twice as fast, uses more water.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_PowerShower</thingClass>
		<size>(1,1)</size>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_ShowerPower</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1,1)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.2</fillPercent>
		<staticSunShadowHeight>0.2</staticSunShadowHeight>
		<castEdgeShadows>true</castEdgeShadows>
		<uiIconScale>0.8</uiIconScale>
		<costList>
			<Steel>10</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<Mass>12</Mass>
			<WorkToBuild>3000</WorkToBuild>
			<Beauty>8</Beauty>
			<Comfort>1.2</Comfort>
			<Flammability>0</Flammability>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>75</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
		</comps>
		<researchPrerequisites>
			<li>CK_AdvancedShowers</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
