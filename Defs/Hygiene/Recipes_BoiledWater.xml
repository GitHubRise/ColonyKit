<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 鍑夌櫧寮€锛氭嬁涓€鐡?1 L 鐡惰姘村埌绡濈伀/鐐夌伓鐑у紑锛屾斁鍑夊悗瑁呭洖涓€鐡讹紱涓嶄細涓瘨銆?-->
	<RecipeDef>
		<defName>CK_BoilWater</defName>
		<label>boil water</label>
		<description>Boil one 1 L bottle of water on a campfire or stove, then let it cool into boiled water. Boiling kills germs, so it cannot cause food poisoning.</description>
		<jobString>boiling water.</jobString>
		<workAmount>200</workAmount>
		<workSpeedStat>CookSpeed</workSpeedStat>
		<workSkill>Cooking</workSkill>
		<uiIconThing>CK_BoiledWater</uiIconThing>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>CK_MineralWater</li>
						<li>CK_PurifiedWater</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<products>
			<CK_BoiledWater>1</CK_BoiledWater>
		</products>
		<recipeUsers>
			<li>Campfire</li>
			<li>FueledStove</li>
			<li>ElectricStove</li>
		</recipeUsers>
		<displayPriority>60</displayPriority>
	</RecipeDef>

