<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 水龙头：需要建造、接水网的水龙头 + 150 L 小水箱。
	     可以喝水、洗手、用水桶接水；检视页能设置「取水次数」和「制冰次数」。
	     建在水面上时作为同网水泵的地表进水口，可经水管远距离供水。
	     另有一个免费取水点（CK_WaterSpot，蓝色地贴，无需建造）。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_WaterPoint</defName>
		<label>water tap</label>
		<description>A constructed water tap with a small 150 L tank. Colonists can drink and wash here, and fill buckets from it. Set a number of draws and they will carry water here from a well on the same network, or from a nearby pond or river, using buckets. Build it on water and it becomes a surface intake that pumps on the same network can draw from, so water can be piped over long distances. Below 0°C, water in the tank can be frozen into ice blocks. Pumped networks fill buckets quickly; without a pump, drawing at the well is slow.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_WaterPoint</thingClass>
		<terrainAffordanceNeeded IsNull="True" />
		<minifiedDef>MinifiedThing</minifiedDef>
		<size>(1,1)</size>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_WaterPoint</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,1)</drawSize>
			<shaderType>Cutout</shaderType>
		</graphicData>
		<rotatable>false</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>45</uiOrder>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.2</fillPercent>
		<pathCost>8</pathCost>
		<tickerType>Normal</tickerType>
		<castEdgeShadows>true</castEdgeShadows>
		<costList>
			<Steel>25</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>5</Mass>
			<WorkToBuild>300</WorkToBuild>
			<Beauty>0</Beauty>
			<Flammability>0</Flammability>
		</statBases>
		<inspectorTabs>
			<li>ColonyKit.Modules.Hygiene.ITab_WaterPoint</li>
		</inspectorTabs>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_WaterStorage">
				<WaterStorageCap>150</WaterStorageCap>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_SurfaceWaterInlet">
				<Capacity>2000</Capacity>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>50</basePowerConsumption>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>

	<!-- 免费取水点：蓝色地贴，类似屠宰点。无需材料/研究，WorkToBuild 0；
	     放下去就能喝水、洗手、用水桶打水，不接水网、不存水，视为无限地表水源。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_WaterSpot</defName>
		<label>water spot</label>
		<description>A free blue water collection spot, like a butcher spot. Needs no materials or research and is built instantly. Colonists can drink and wash here, and fill buckets directly. It does not need pipes or a tank; it counts as an unlimited surface water source.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_WaterSpot</thingClass>
		<terrainAffordanceNeeded IsNull="True" />
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_WaterSpot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<useHitPoints>false</useHitPoints>
		<size>(1,1)</size>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>5</uiOrder>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.1</fillPercent>
		<rotatable>false</rotatable>
		<surfaceType>Item</surfaceType>
		<statBases>
			<WorkToBuild>0</WorkToBuild>
			<Mass>0.1</Mass>
		</statBases>
		<building>
			<isInert>true</isInert>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<placeWorkers>
			<li>ColonyKit.Modules.Hygiene.PlaceWorker_WaterSpot</li>
		</placeWorkers>
		<inspectorTabs>
			<li>ColonyKit.Modules.Hygiene.ITab_WaterSpot</li>
		</inspectorTabs>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_FreeWaterInlet">
				<Capacity>2000</Capacity>
			</li>
		</comps>
	</ThingDef>

	<!-- 水桶：比脸盆大（60 L），用来从水龙头/水井/取水点接水、倒进水盆或水箱。 -->

	<ThingDef ParentName="ResourceBase">
		<defName>CK_WaterBucket</defName>
		<label>water bucket</label>
		<description>A sturdy steel bucket for carrying water. Holds 60 L. Fill it at a water point, a well, or a pond or river; drink from it, or pour it into a water tub or tank. Water never spoils.</description>
		<graphicData>
			<texPath>Things/Item/CK_WaterBucket</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.9,0.9)</drawSize>
		</graphicData>
		<uiIconScale>1.2</uiIconScale>
		<rotatable>false</rotatable>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<stackLimit>1</stackLimit>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_BasinWater">
				<Capacity>60</Capacity>
			</li>
		</comps>
		<statBases>
			<Mass>1.5</Mass>
			<WorkToMake>500</WorkToMake>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>0</Flammability>
			<DeteriorationRate>2</DeteriorationRate>
			<MarketValue>22</MarketValue>
		</statBases>
	</ThingDef>

	<RecipeDef>
		<defName>CK_MakeWaterBucket</defName>
		<label>make water bucket</label>
		<description>Craft a steel bucket for carrying water.</description>
		<jobString>making a water bucket.</jobString>
		<workAmount>500</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<products>
			<CK_WaterBucket>1</CK_WaterBucket>
		</products>
		<recipeUsers>
			<li>CraftingSpot</li>
		</recipeUsers>
		<researchPrerequisite>CK_HygieneResearch</researchPrerequisite>
	</RecipeDef>

	<!-- 冰块：10 L 水冻成的一块冰，不腐烂、不降解；放在取水点旁融化回水。 -->
	<ThingDef ParentName="ResourceBase">
		<defName>CK_IceBlock</defName>
		<label>ice block</label>
		<description>A block of ice holding 10 L of water. It never spoils. Place it near a water point in a warm room and melt it to recover the water.</description>
		<graphicData>
			<texPath>Things/Item/CK_IceBlock</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.75,0.75)</drawSize>
		</graphicData>
		<uiIconScale>1.1</uiIconScale>
		<rotatable>false</rotatable>
		<thingCategories>
			<li>Resources</li>
		</thingCategories>
		<stackLimit>20</stackLimit>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_IceBlock">
				<WaterLiters>10</WaterLiters>
			</li>
		</comps>
		<statBases>
			<Mass>0.5</Mass>
			<MarketValue>6</MarketValue>
			<MaxHitPoints>50</MaxHitPoints>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>
</Defs>
