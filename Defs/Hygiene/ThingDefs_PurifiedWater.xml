<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 纯净水：1 瓶按 1 L 水计算；从带净水器的水龙头装瓶，喝完不会中毒。 -->
	<ThingDef ParentName="ResourceBase">
		<defName>CK_PurifiedWater</defName>
		<label>purified water</label>
		<description>A sealed 1 L bottle of purified water. Drink it directly to restore thirst. It is filtered and cannot cause food poisoning.</description>
		<graphicData>
			<texPath>Things/Item/CK_PurifiedWater</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
			<drawSize>(0.6,0.9)</drawSize>
		</graphicData>
		<uiIconScale>1.2</uiIconScale>
		<rotatable>false</rotatable>
		<thingCategories>
			<li>Foods</li>
		</thingCategories>
		<stackLimit>25</stackLimit>
		<ingestible>
			<preferability>NeverForNutrition</preferability>
			<foodType>Fluid</foodType>
			<baseIngestTicks>60</baseIngestTicks>
			<babiesCanIngest>true</babiesCanIngest>
		</ingestible>
		<statBases>
			<Mass>1</Mass>
			<MarketValue>3</MarketValue>
			<MaxHitPoints>30</MaxHitPoints>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<Nutrition>0.01</Nutrition>
		</statBases>
	</ThingDef>
</Defs>
