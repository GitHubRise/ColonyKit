<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThoughtDef>
		<defName>CK_HygieneDirty</defName>
		<workerClass>ColonyKit.Modules.Hygiene.ThoughtWorker_Hygiene</workerClass>
		<stages>
			<li>
				<label>filthy</label>
				<description>I smell like I have been swimming in sewage.</description>
				<baseMoodEffect>-6</baseMoodEffect>
			</li>
			<li>
				<label>grimy</label>
				<description>I feel a little grimy.</description>
				<baseMoodEffect>-3</baseMoodEffect>
			</li>
			<li>
				<label>clean</label>
				<description>I feel fresh and clean.</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
			<li>
				<label>squeaky clean</label>
				<description>I'm squeaky clean!</description>
				<baseMoodEffect>6</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef>
		<defName>CK_ShowerHot</defName>
		<durationDays>0.2</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>hot shower</label>
				<description>I had a nice hot shower.</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef>
		<defName>CK_ShowerCold</defName>
		<durationDays>0.1</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>cold water</label>
				<description>There was no hot water!</description>
				<baseMoodEffect>-3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>CK_WashPrivacy</defName>
		<durationDays>0.1</durationDays>
		<stackLimit>6</stackLimit>
		<stages>
			<li>
				<label>embarrassed</label>
				<description>Someone saw me bathing and it made me uncomfortable.</description>
				<baseMoodEffect>-3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
</Defs>
