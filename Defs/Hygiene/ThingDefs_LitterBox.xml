<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 猫砂盆（DBH LitterBox 的 1:1 移植）：1×1、15 材料、不需要任何管道。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_LitterBox</defName>
		<label>litter box</label>
		<description>An indoor faeces and urine collection box for small animals.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Litterbox</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_LitterBox</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
		</graphicData>
		<rotatable>false</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>23</uiOrder>
		<tickerType>Never</tickerType>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<pathCost>8</pathCost>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>15</costStuffCount>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<WorkToBuild>250</WorkToBuild>
			<Flammability>1</Flammability>
			<Beauty>-5</Beauty>
			<Cleanliness>-5</Cleanliness>
			<Mass>5</Mass>
		</statBases>
		<comps>
			<li>
				<compClass>CompColorable</compClass>
			</li>
			<li Class="CompProperties_Forbiddable" />
		</comps>
		<researchPrerequisites>
			<li>CK_Plumbing</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
