<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 焚烧坑（DBH BurnPit 的对应物）：粪渣当燃料，顺带处理尸体/衣物/毒品。
	     1×1、钢 20、无研究前置；贴图取 DBH 的 burnPit。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_BurnPit</defName>
		<label>burn pit</label>
		<description>A shallow pit where fecal sludge is burned as fuel. Can also dispose of corpses, apparel and drugs through bills. Colonists lingering nearby while it burns may get filthy.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_BurnPit</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_BurnPit</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawRotated>false</drawRotated>
			<allowFlip>false</allowFlip>
			<damageData>
				<rect>(0.2,0,0.6,0.1)</rect>
			</damageData>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<constructEffect>ConstructDirt</constructEffect>
		<tickerType>Normal</tickerType>
		<drawerType>RealtimeOnly</drawerType>
		<fillPercent>0.2</fillPercent>
		<rotatable>false</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>9</uiOrder>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<costList>
			<Steel>20</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToBuild>200</WorkToBuild>
			<Flammability>0</Flammability>
			<Mass>10</Mass>
		</statBases>
		<placeWorkers>
			<li>PlaceWorker_Heater</li>
			<li>PlaceWorker_InvalidOverSubstructure</li>
		</placeWorkers>
		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
		<soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
		<designationHotKey>Misc1</designationHotKey>
		<comps>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>100</fuelConsumptionRate>
				<fuelCapacity>250</fuelCapacity>
				<fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
				<fuelFilter>
					<thingDefs>
						<li>CK_FecalSludge</li>
					</thingDefs>
				</fuelFilter>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
				<!-- 不写这个字段，1.6 的 CompRefuelable 会在空转时也按 fuelConsumptionRate 烧燃料
				     （100/天，露天再加 36/天），250 容量的坑两天空。原版燃料工作台都显式写 true。 -->
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
			</li>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>21</heatPerSecond>
				<heatPushMaxTemperature>28</heatPushMaxTemperature>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>10</glowRadius>
				<glowColor>(252,187,113,0)</glowColor>
			</li>
		</comps>
		<recipes>
			<li>CremateCorpse</li>
			<li>BurnApparel</li>
			<li>BurnDrugs</li>
		</recipes>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<heatPerTickWhileWorking>0.4</heatPerTickWhileWorking>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<isInert>true</isInert>
		</building>
		<specialDisplayRadius>13.9</specialDisplayRadius>
		<constructionSkillPrerequisite>3</constructionSkillPrerequisite>
	</ThingDef>
</Defs>
