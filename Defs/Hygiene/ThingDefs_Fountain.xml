<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 水池 / 饮水喷泉（DBH Fountain 的 1:1 移植）：1×1、画 2×2，能喝水也能洗手。
	     DBH 的 Fountain 继承 Building_WaterFeature（会画水面焦散），CK 里直接用 Building_Basin，
	     底图本身就是带水的水池，省掉纯视觉的焦散层。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_Fountain</defName>
		<label>fountain</label>
		<description>A water fountain used for drinking and washing.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Basin</thingClass>
		<tickerType>Normal</tickerType>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_Fountain</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>24</uiOrder>
		<hasInteractionCell>false</hasInteractionCell>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<pathCost>8</pathCost>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>10</costStuffCount>
		<costList>
			<Steel>5</Steel>
		</costList>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<WorkToBuild>550</WorkToBuild>
			<Flammability>1</Flammability>
			<Cleanliness>1</Cleanliness>
			<Beauty>10</Beauty>
			<Mass>5</Mass>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_ModernFixtures</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
