<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 冰箱（DBH HygieneRefrigerator 的移植）：DBH 原版的容器接口被注释掉了，
	     这里落成 1×1 自带制冷的食物柜——物品摆在格子上，原版搬运/取料/进食都能直接用；
	     通电并打开时，格上的食物停止腐烂（Patch_CompRottable_Fridge）。贴图四向，west 用 east 的复制件。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_Fridge</defName>
		<label>refrigerator</label>
		<description>A self-contained refrigerator. Requires 50 W and keeps stored food from spoiling while powered. Haulers stock it automatically.</description>
		<thingClass>Building_Storage</thingClass>
		<tickerType>Normal</tickerType>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_Fridge</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.5,1.5)</drawSize>
		</graphicData>
		<rotatable>true</rotatable>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsFurniture</li>
		</thingCategories>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>48</uiOrder>
		<canOverlapZones>false</canOverlapZones>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<blockWind>true</blockWind>
		<castEdgeShadows>true</castEdgeShadows>
		<pathCost>60</pathCost>
		<costList>
			<Steel>80</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>1200</WorkToBuild>
			<Mass>25</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>3</maxItemsInCell>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<categories>
						<li>Foods</li>
					</categories>
				</filter>
			</defaultStorageSettings>
			<fixedStorageSettings>
				<filter>
					<categories>
						<li>Foods</li>
					</categories>
				</filter>
			</fixedStorageSettings>
		</building>
		<inspectorTabs>
			<li>ITab_Storage</li>
		</inspectorTabs>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>50</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Fridge" />
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
