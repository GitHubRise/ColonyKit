<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_Basin</defName>
		<label>basin</label>
		<description>DBH-style bathroom basin for washing hands. Requires water.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Basin</thingClass>
		<tickerType>Normal</tickerType>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_Basin</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<costList>
			<Steel>15</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<Mass>5</Mass>
			<WorkToBuild>550</WorkToBuild>
			<Beauty>10</Beauty>
			<Cleanliness>1</Cleanliness>
			<Flammability>1</Flammability>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>CK_Bath</defName>
		<label>bathtub</label>
		<description>DBH-style bathtub. Needs 190 L and hot water for a hot bath.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Bath</thingClass>
		<tickerType>Rare</tickerType>
		<size>(1,2)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_Bath</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<!-- 贴图是 DBH 的 bath_*（128x192 / 192x128，2:3）。
			     DBH 原版用 (2,3)，这里保持一致，尺寸与观感才对得上；
			     drawSize 大于占地 1x2 的贴图是建筑常态（同床、雕像），溢出不挡路。 -->
			<drawSize>(2,3)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<costList>
			<Steel>60</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>50</Mass>
			<WorkToBuild>900</WorkToBuild>
			<Beauty>10</Beauty>
			<Comfort>0.9</Comfort>
			<JoyGainFactor>0.7</JoyGainFactor>
			<Flammability>1</Flammability>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>CK_DoubleBath</defName>
		<label>double bathtub</label>
		<description>A 2x2 double bathtub. Two colonists can bathe at the same time; a bather may invite an opposite-sex partner to join, depending on the chance set in the hygiene settings.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_DoubleBath</thingClass>
		<tickerType>Rare</tickerType>
		<size>(2,2)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_DoubleBath</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<!-- 128x130：单缸左半边拉伸镜像成一只宽缸，64 像素/格，正好落在 2x2 占地上。 -->
			<drawSize>(2,2.03)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<rotatable>false</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiIconScale>0.8</uiIconScale>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.2</fillPercent>
		<costList>
			<Steel>120</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>220</MaxHitPoints>
			<Mass>90</Mass>
			<WorkToBuild>2200</WorkToBuild>
			<Beauty>20</Beauty>
			<Comfort>1.1</Comfort>
			<JoyGainFactor>0.9</JoyGainFactor>
			<Flammability>1</Flammability>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
