<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<StatDef>
		<defName>CK_HygieneRateMultiplier</defName>
		<label>hygiene rate multiplier</label>
		<description>Multiplier for how quickly hygiene falls.</description>
		<category>Basics</category>
		<defaultBaseValue>1</defaultBaseValue>
		<minValue>0</minValue>
		<maxValue>10</maxValue>
		<workerClass>StatWorker</workerClass>
		<showOnHumanlikes>true</showOnHumanlikes>
		<showOnAnimals>false</showOnAnimals>
		<showOnMechanoids>false</showOnMechanoids>
	</StatDef>

	<StatDef>
		<defName>CK_BladderRateMultiplier</defName>
		<label>bladder rate multiplier</label>
		<description>Multiplier for how quickly the bladder fills.</description>
		<category>Basics</category>
		<defaultBaseValue>1</defaultBaseValue>
		<minValue>0</minValue>
		<maxValue>10</maxValue>
		<workerClass>StatWorker</workerClass>
		<showOnHumanlikes>true</showOnHumanlikes>
		<showOnAnimals>false</showOnAnimals>
		<showOnMechanoids>false</showOnMechanoids>
	</StatDef>

	<HediffDef ParentName="DiseaseBase">
		<defName>CK_GutBug</defName>
		<label>gut infection</label>
		<description>A gut infection picked up from contaminated water or poor hygiene. Causes vomiting and frequent bathroom trips, then clears on its own.</description>
		<initialSeverity>1</initialSeverity>
		<isBad>true</isBad>
		<makesSickThought>true</makesSickThought>
		<tendable>true</tendable>
		<comps>
			<li Class="HediffCompProperties_TendDuration">
				<baseTendDurationHours>24</baseTendDurationHours>
				<severityPerDayTended>-0.5</severityPerDayTended>
			</li>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-1</severityPerDay>
			</li>
		</comps>
		<stages>
			<li>
				<label>queasy</label>
				<vomitMtbDays>1.5</vomitMtbDays>
				<statOffsets>
					<CK_BladderRateMultiplier>0.25</CK_BladderRateMultiplier>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.5</minSeverity>
				<label>sick</label>
				<vomitMtbDays>0.75</vomitMtbDays>
				<statOffsets>
					<CK_BladderRateMultiplier>0.75</CK_BladderRateMultiplier>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>CK_BadHygiene</defName>
		<label>bad hygiene</label>
		<description>Poor personal hygiene. Increases disease risk and social penalties.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.85,0.65,0.35)</defaultLabelColor>
		<isBad>true</isBad>
		<initialSeverity>0</initialSeverity>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<label>grubby</label>
				<minSeverity>0</minSeverity>
				<becomeVisible>false</becomeVisible>
			</li>
			<li>
				<label>filthy</label>
				<minSeverity>0.4</minSeverity>
				<becomeVisible>true</becomeVisible>
			</li>
		</stages>
	</HediffDef>
</Defs>
