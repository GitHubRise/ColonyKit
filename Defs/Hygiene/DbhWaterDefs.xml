<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Water pipe: laid like a power conduit, does not block movement, can run under walls/buildings. -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_DbhWaterPipe</defName>
		<label>water pipe</label>
		<description>Plumbing for connecting water wells, pumps, tanks, heaters and fixtures. Can be placed under walls and other buildings, like a power conduit.</description>
		<thingClass>Building</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_WaterPipe_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom5</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Hygiene/CK_WaterPipe_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
			<canLandGravshipOn>true</canLandGravshipOn>
			<blueprintGraphicData>
				<texPath>Things/Building/Hygiene/CK_WaterPipe_Atlas_Blueprint</texPath>
			</blueprintGraphicData>
			<canConstructInCorner>true</canConstructInCorner>
		</building>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Conduits</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToBuild>45</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Beauty>-2</Beauty>
		</statBases>
		<drawStyleCategory>Default1D</drawStyleCategory>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<neverMultiSelect>true</neverMultiSelect>
		<clearBuildingArea>false</clearBuildingArea>
		<tickerType>Never</tickerType>
		<costList>
			<Steel>1</Steel>
		</costList>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>10</uiOrder>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>

	<!-- 1x1 water tank. Art is one cell wide and two cells tall, like DBH's hot water tank. -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_DbhWaterTank</defName>
		<label>water tank</label>
		<description>Stores water for plumbed fixtures. Capacity: 2000 L.</description>
		<thingClass>Building</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_WaterTank</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,2)</drawSize>
		</graphicData>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.3</fillPercent>
		<tickerType>Normal</tickerType>
		<costList>
			<Steel>80</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>25</Mass>
			<WorkToBuild>500</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_WaterStorage">
				<WaterStorageCap>2000</WaterStorageCap>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
		<uiOrder>20</uiOrder>
	</ThingDef>

	<!-- 2x2 giant water tank. -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_DbhWaterTankGiant</defName>
		<label>giant water tank</label>
		<description>Stores a large amount of water for plumbed fixtures. Capacity: 8000 L.</description>
		<thingClass>Building</thingClass>
		<size>(2,2)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_WaterTankGiant</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,3)</drawSize>
		</graphicData>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.3</fillPercent>
		<tickerType>Normal</tickerType>
		<costList>
			<Steel>200</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>50</Mass>
			<WorkToBuild>2000</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_WaterStorage">
				<WaterStorageCap>8000</WaterStorageCap>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
		<uiOrder>30</uiOrder>
	</ThingDef>

	<!-- 1x1 electric pump. Needs a water well in the same network. -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_DbhWaterPump</defName>
		<label>water pump</label>
		<description>Pumps ground water from water wells into connected tanks. Requires power and at least one water well. Capacity: 1500 L/day.</description>
		<thingClass>Building</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_WaterPump</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.25</fillPercent>
		<costList>
			<Steel>80</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>25</Mass>
			<WorkToBuild>1500</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>250</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Breakdownable" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_WaterPumpingStation">
				<Capacity>1500</Capacity>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
		<uiOrder>40</uiOrder>
	</ThingDef>

	<!-- 1x1 water well: ground-water source for pumps. -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_DbhWaterWell</defName>
		<label>water well</label>
		<description>Provides ground water to connected pumps. One well can feed any number of pumps on the same water network. Capacity: 2000 L/day.</description>
		<thingClass>Building</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_WaterWell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.25</fillPercent>
		<costList>
			<Steel>50</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>20</Mass>
			<WorkToBuild>3000</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_WaterInlet">
				<Capacity>2000</Capacity>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
		<uiOrder>50</uiOrder>
	</ThingDef>

	<!-- 1x1 electric water heater: gives hot showers while powered. -->
	<ThingDef ParentName="BuildingBase">
		<defName>CK_DbhWaterHeater</defName>
		<label>water heater</label>
		<description>Heats water for connected showers and has a small built-in hot water tank. Add hot water tanks for more hot water; requires power.</description>
		<thingClass>Building</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_WaterHeater</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,2)</drawSize>
		</graphicData>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.25</fillPercent>
		<tickerType>Normal</tickerType>
		<costList>
			<Steel>75</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>20</Mass>
			<WorkToBuild>1200</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>250</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_WaterHeater">
				<Capacity>250</Capacity>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_HeatStore">
				<StoreCapacity>100</StoreCapacity>
				<RiseRate>0.0024</RiseRate>
				<FallRate>0.00001</FallRate>
				<ForRunningWater>true</ForRunningWater>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
		<uiOrder>60</uiOrder>
	</ThingDef>
</Defs>
