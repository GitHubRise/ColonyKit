<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_Toilet</defName>
		<label>toilet</label>
		<description>DBH-style toilet. Uses 14 L per flush; colonist bladder need uses it automatically.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Toilet</thingClass>
		<tickerType>Rare</tickerType>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_Toilet</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<costList>
			<Steel>15</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<Mass>18</Mass>
			<WorkToBuild>950</WorkToBuild>
			<Beauty>1</Beauty>
			<Comfort>0.1</Comfort>
			<Flammability>1</Flammability>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Sewage</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>CK_SewagePipe</defName>
		<label>sewage pipe</label>
		<description>DBH-style sewage pipe. Connects toilets to septic tanks.</description>
		<thingClass>Building</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<!-- 和 DBH 一样用 4×4 连管图集，按四邻自动选片；原来是 Graphic_Multi 的单向“方口+竖嘴”贴图，
			     去掉旋转后所有污水管都只剩同一个朝向，看起来像一排“口”字。 -->
			<texPath>Things/Building/Hygiene/CK_WaterPipe_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom6</li>
			</linkFlags>
			<!-- 与水管的白色区分：淡橄榄绿。 -->
			<color>(0.74,0.82,0.64)</color>
			<drawSize>(1,1)</drawSize>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<!-- 连管图集的 graphicData.Linked 为 true；原版 GhostUtility 会直接拿
		     uiIconPath 生成放置虚影，没有 uiIconPath 就会用 null 路径查
		     ContentFinder，选中污水管设计器时每帧抛 ArgumentNullException。 -->
		<uiIconPath>Things/Building/Hygiene/CK_WaterPipe_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
			<canLandGravshipOn>true</canLandGravshipOn>
			<canConstructInCorner>true</canConstructInCorner>
			<blueprintGraphicData>
				<texPath>Things/Building/Hygiene/CK_WaterPipe_Atlas_Blueprint</texPath>
			</blueprintGraphicData>
		</building>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Conduits</altitudeLayer>
		<passability>Standable</passability>
		<pathCost>0</pathCost>
		<fillPercent>0.05</fillPercent>
		<neverMultiSelect>true</neverMultiSelect>
		<tickerType>Never</tickerType>
		<drawStyleCategory>Default1D</drawStyleCategory>
		<!-- 管道按四邻自动连管，不需要 Q/E 旋转；和 DBH 原版、CK 水管保持一致。 -->
		<rotatable>false</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<uiOrder>15</uiOrder>
		<costList>
			<Steel>10</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<Mass>3</Mass>
			<WorkToBuild>200</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Sewage</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_Plumbing</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>CK_SepticTank</defName>
		<label>septic tank</label>
		<description>DBH-style septic tank. Stores sewage until emptied.</description>
		<thingClass>Building</thingClass>
		<size>(2,2)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_SepticTank</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<rotatable>false</rotatable>
		<designationCategory>CK_Hygiene</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.3</fillPercent>
		<tickerType>Rare</tickerType>
		<costList>
			<Steel>100</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<Mass>30</Mass>
			<WorkToBuild>1200</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Sewage</mode>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_SewageHandler">
				<capacity>10000</capacity>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_SepticTanks</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
