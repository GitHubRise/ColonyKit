<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_Toilet</defName>
		<label>toilet</label>
		<description>DBH-style toilet. Uses 14 L per flush; colonist bladder need uses it automatically.</description>
		<thingClass>ColonyKit.Modules.Hygiene.Building_Toilet</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_Toilet</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<rotatable>true</rotatable>
		<designationCategory>Furniture</designationCategory>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.15</fillPercent>
		<costList>
			<Steel>15</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<Mass>18</Mass>
			<WorkToBuild>950</WorkToBuild>
			<Beauty>1</Beauty>
			<Comfort>0.1</Comfort>
			<Flammability>1</Flammability>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.CompProperties_Blockage" />
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Water</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>CK_SewagePipe</defName>
		<label>sewage pipe</label>
		<description>DBH-style sewage pipe. Connects toilets to septic tanks.</description>
		<thingClass>Building</thingClass>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_SewagePipe</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<designationCategory>Furniture</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.05</fillPercent>
		<costList>
			<Steel>10</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<Mass>3</Mass>
			<WorkToBuild>200</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Sewage</mode>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>CK_SepticTank</defName>
		<label>septic tank</label>
		<description>DBH-style septic tank. Stores sewage until emptied.</description>
		<thingClass>Building</thingClass>
		<size>(2,2)</size>
		<graphicData>
			<texPath>Things/Building/Hygiene/CK_SepticTank</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<designationCategory>Furniture</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.3</fillPercent>
		<costList>
			<Steel>100</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<Mass>30</Mass>
			<WorkToBuild>1200</WorkToBuild>
		</statBases>
		<comps>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_Pipe">
				<mode>Sewage</mode>
			</li>
			<li Class="ColonyKit.Modules.Hygiene.Dbh.CompProperties_SewageHandler">
				<capacity>10000</capacity>
			</li>
		</comps>
		<researchPrerequisites>
			<li>CK_HygieneResearch</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
