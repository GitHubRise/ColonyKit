<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 粪渣炼油（DBH Recipes_Production 的移植）：生物燃料精炼厂把 75 桶粪渣炼成 35 化合燃料。 -->
	<RecipeDef>
		<defName>CK_MakeChemfuelFromFecalSludge</defName>
		<label>make chemfuel from fecal sludge</label>
		<description>Refine a batch of fecal sludge into chemfuel. One way to get something useful out of the latrine.</description>
		<jobString>Refining chemfuel from fecal sludge.</jobString>
		<effectWorking>Cremate</effectWorking>
		<soundWorking>Recipe_Cremate</soundWorking>
		<workAmount>3000</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>CK_FecalSludge</li>
					</thingDefs>
				</filter>
				<count>75</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>CK_FecalSludge</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Chemfuel>35</Chemfuel>
		</products>
		<recipeUsers>
			<li>BiofuelRefinery</li>
		</recipeUsers>
	</RecipeDef>
</Defs>
