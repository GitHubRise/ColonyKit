<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_ConveyorHub</defName>
		<label>conveyor turntable</label>
		<description>A 1x1 conveyor turntable. Items can enter from any of the four sides and leave through the side set by the building's rotation, allowing right-angle turns.</description>
		<size>(1,1)</size>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingClass>ColonyKit.Modules.Storage.Building_ConveyorTurntable</thingClass>
		<graphicData>
			<texPath>Things/Building/Storage/CK_ConveyorTurntable</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<rotatable>true</rotatable>
		<tickerType>Normal</tickerType>
		<drawerType>RealtimeOnly</drawerType>
		
		<thingCategories>
			<li>Buildings</li>
		</thingCategories>
		<passability>PassThroughOnly</passability>
		<building>
			<maxItemsInCell>1</maxItemsInCell>
		</building>
		<fillPercent>0.1</fillPercent>
		<staticSunShadowHeight>0.1</staticSunShadowHeight>
		<castEdgeShadows>true</castEdgeShadows>
		<uiIconScale>0.9</uiIconScale>
		<costList>
			<Steel>30</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>8</Mass>
			<WorkToBuild>500</WorkToBuild>
			<Beauty>-1</Beauty>
			<Flammability>0</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>CK_StorageTier3</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
