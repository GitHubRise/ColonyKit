<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_ConveyorHub</defName>
		<label>omnidirectional conveyor</label>
		<description>A 2x2 omnidirectional conveyor. Items can enter and leave from any of the four sides; the central turntable handles turns. The texture is symmetric, so rotating the building does not change the footprint.</description>
		<size>(2,2)</size>
		<thingClass>ColonyKit.Modules.Storage.Building_OmnidirectionalConveyor</thingClass>
		<graphicData>
			<texPath>Things/Building/Storage/CK_ConveyorHub</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<rotatable>true</rotatable>
		<tickerType>Normal</tickerType>
		<drawerType>RealtimeOnly</drawerType>
		<designationCategory>Furniture</designationCategory>
		<passability>PassThroughOnly</passability>
		<building>
			<maxItemsInCell>1</maxItemsInCell>
		</building>
		<fillPercent>0.15</fillPercent>
		<staticSunShadowHeight>0.15</staticSunShadowHeight>
		<castEdgeShadows>true</castEdgeShadows>
		<uiIconScale>0.75</uiIconScale>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<Mass>20</Mass>
			<WorkToBuild>800</WorkToBuild>
			<Beauty>-2</Beauty>
			<Flammability>0</Flammability>
		</statBases>
	</ThingDef>
</Defs>
