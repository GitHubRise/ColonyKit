<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_ConveyorBelt</defName>
		<label>bidirectional conveyor</label>
		<description>A 1x1 bidirectional conveyor. Cheap forward/backward belt; no turning. Adjacent bidirectional/omnidirectional conveyors hand items over to each other.</description>
		<size>(1,1)</size>
		<thingClass>ColonyKit.Modules.Storage.Building_BidirectionalConveyor</thingClass>
		<graphicData>
			<texPath>Things/Building/Storage/CK_ConveyorBelt</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<rotatable>true</rotatable>
		<tickerType>Normal</tickerType>
		<drawerType>RealtimeOnly</drawerType>
		<designationCategory>Furniture</designationCategory>
		<passability>PassThroughOnly</passability>
		<building>
			<maxItemsInCell>1</maxItemsInCell>
		</building>
		<fillPercent>0.1</fillPercent>
		<staticSunShadowHeight>0.1</staticSunShadowHeight>
		<castEdgeShadows>true</castEdgeShadows>
		<uiIconScale>0.9</uiIconScale>
		<costList>
			<Steel>15</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>5</Mass>
			<WorkToBuild>250</WorkToBuild>
			<Beauty>-1</Beauty>
			<Flammability>0</Flammability>
		</statBases>
	</ThingDef>
</Defs>
