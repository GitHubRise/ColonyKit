<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>CK_VerticalWarehouse</defName>
		<label>vertical warehouse</label>
		<description>A 2x2 internal warehouse. Colonists can drop items into it and take them out from the inspect pane; contents are stored inside the building and do not occupy map cells. By default it accepts food, herbal medicine, hay, wood, plant matter and wort; internal temperature is adjustable like a cooler.</description>
		<thingClass>ColonyKit.Modules.Storage.Building_VerticalWarehouse</thingClass>
		<size>(2,2)</size>
		<graphicData>
			<texPath>Things/Building/Storage/CK_VerticalWarehouse</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<rotatable>false</rotatable>
		<tickerType>Rare</tickerType>
		<designationCategory>Furniture</designationCategory>
		<staticSunShadowHeight>0.5</staticSunShadowHeight>
		<castEdgeShadows>true</castEdgeShadows>
		<uiIconScale>0.75</uiIconScale>
		<drawGUIOverlay>true</drawGUIOverlay>
		<costList>
			<Steel>150</Steel>
			<ComponentIndustrial>8</ComponentIndustrial>
		</costList>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<Mass>60</Mass>
			<WorkToBuild>3000</WorkToBuild>
			<Beauty>-10</Beauty>
			<Flammability>0</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>CK_StorageTier2</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>250</basePowerConsumption>
			</li>
			<li Class="CompProperties_TempControl">
				<energyPerSecond>21</energyPerSecond>
				<defaultTargetTemperature>4</defaultTargetTemperature>
				<minTargetTemperature>-50</minTargetTemperature>
				<maxTargetTemperature>50</maxTargetTemperature>
			</li>
		</comps>
		<inspectorTabs>
			<li>ColonyKit.Modules.Storage.ITab_VerticalWarehouse</li>
			<li>RimWorld.ITab_Storage</li>
		</inspectorTabs>
	</ThingDef>
</Defs>
