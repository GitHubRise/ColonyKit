<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<AssemblyName>EdBPrepareCarefully</AssemblyName>
		<RootNamespace>EdB.PrepareCarefully</RootNamespace>
		<Version>1.6.2</Version>
		<LangVersion>7.3</LangVersion>
		<Nullable>disable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
		<OutputPath>..\..\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>
	<ItemGroup>
		<!-- 内置「精心准备」：上游源码原样镜像在 ..\PrepareCarefully，编成 EdBPrepareCarefully.dll。
		     工程单独放一个目录，避免和 ColonyKit.csproj 共用 Source\obj。 -->
		<Compile Include="..\PrepareCarefully\**\*.cs" Exclude="..\PrepareCarefully\obj\**;..\PrepareCarefully\bin\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
		<PackageReference Include="Lib.Harmony" Version="2.4.3" />
	</ItemGroup>
</Project>
