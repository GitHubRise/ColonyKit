	<ColonyKit.Settings.Robotics.AreaMode>区域模式</ColonyKit.Settings.Robotics.AreaMode>
	<ColonyKit.Settings.Robotics.Area.Unrestricted>不限</ColonyKit.Settings.Robotics.Area.Unrestricted>
