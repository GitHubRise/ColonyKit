	<ColonyKit.Settings.Bubbles.Direction.Up>Up</ColonyKit.Settings.Bubbles.Direction.Up>
	<ColonyKit.Settings.Bubbles.Direction.Left>Left</ColonyKit.Settings.Bubbles.Direction.Left>

	<ColonyKit.Settings.Bubbles.Color.Background>Background color</ColonyKit.Settings.Bubbles.Color.Background>
	<ColonyKit.Settings.Bubbles.Color.Foreground>Text color</ColonyKit.Settings.Bubbles.Color.Foreground>
	<ColonyKit.Settings.Bubbles.Color.BackgroundSelected>Background color (selected)</ColonyKit.Settings.Bubbles.Color.BackgroundSelected>
